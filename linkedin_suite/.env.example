# LinkedIn Developer App Credentials
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# 60-Day Access Token (Generated via `python3 src/cli.py login` or Developer Portal)
LINKEDIN_ACCESS_TOKEN=AQX...

# 365-Day Refresh Token for background silent rotation
LINKEDIN_REFRESH_TOKEN=AQY...

# Author URN (e.g. urn:li:person:12345 or urn:li:organization:67890)
LINKEDIN_AUTHOR_URN=urn:li:person:your_member_id

# API Version (Monthly format)
LINKEDIN_API_VERSION=202401
