# Firecrawl API Key (Get yours at https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY

# Local LLM Configuration (Default: Ollama / LM Studio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Optional Cloud LLM Fallback (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=
