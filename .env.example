# ==============================================================================
# AI Agent Workspace & MCP Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MCP Server API Keys & Configuration
# ------------------------------------------------------------------------------
# Firecrawl API Key (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-YOUR_FIRECRAWL_API_KEY

# GitHub Personal Access Token (for GitHub MCP server)
# Requires repo/read permissions (https://github.com/settings/tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_GITHUB_TOKEN

# Brave Search API Key (https://brave.com/search/api/)
BRAVE_API_KEY=BSA_YOUR_BRAVE_SEARCH_API_KEY

# Supabase / PostgreSQL (for Database MCP servers)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (OpenAI, Local Ollama, LM Studio, etc.)
# ------------------------------------------------------------------------------
# Local LLM default (Ollama / LM Studio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Optional Cloud LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Workspace & Tool Preferences
# ------------------------------------------------------------------------------
# Default target for skill exports: [agy | claude | cursor | copilot | windsurf | all]
AGENT_DEFAULT_TARGET=all
